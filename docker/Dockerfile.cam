FROM osrf/ros:humble-desktop AS base

ENV ROS_DISTRO=humble
ENV YOLO_CONFIG_DIR=/tmp/Ultralytics
SHELL ["/bin/bash", "-c"]

WORKDIR /ros2_ws/src

RUN apt-get update && apt-get install -y curl \
    python3-colcon-common-extensions python3-dev python3-setuptools python3-wheel python3-opencv \
    libgl1 libglib2.0-0 ros-humble-cv-bridge ros-humble-image-transport \
    && apt-get install -y python3.10-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /ros2_ws/src/camera_pipeline/.venv/yolo
RUN . /ros2_ws/src/camera_pipeline/.venv/yolo/bin/activate \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir numpy==1.26.4 scipy==1.11.4 opencv-python==4.10.0.84 "ultralytics>=8.3,<9"

RUN mkdir -p /tmp/Ultralytics && chmod 777 /tmp/Ultralytics
RUN mkdir -p /models && curl --fail --location --retry 5 --retry-delay 2 --output /models/yolo11n-seg.pt \
    "https://huggingface.co/Ultralytics/YOLO11/resolve/main/yolo11n-seg.pt?download=true"

FROM base AS dev

WORKDIR /ros2_ws
CMD ["bash"]

FROM base AS production

# COPY ./launch /ros2_ws/src/camera_pipeline/launch
# COPY ./camera_pipeline /ros2_ws/src/camera_pipeline/camera_pipeline
# COPY ./resource /ros2_ws/src/camera_pipeline/resource
# COPY ./test /ros2_ws/src/camera_pipeline/test
# COPY ./LICENSE /ros2_ws/src/camera_pipeline/LICENSE
# COPY ./package.xml /ros2_ws/src/camera_pipeline/package.xml
# COPY ./setup.cfg /ros2_ws/src/camera_pipeline/setup.cfg
# COPY ./setup.py /ros2_ws/src/camera_pipeline/setup.py

WORKDIR /ros2_ws
RUN source /opt/ros/$ROS_DISTRO/setup.bash && colcon build

CMD ["bash"]